# AI judges
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Search + Maps hunters. Free plan = 250 searches a month: background hunts pause
# at 100 left so console hunts keep working, and results are cached for 6 hours.
SERPAPI_KEY=

# Threat intelligence (all optional; each one adds evidence when present)
GOOGLE_SAFE_BROWSING_KEY=
# Free VirusTotal keys allow 4 lookups a minute; extra lookups are skipped, not queued
VIRUSTOTAL_KEY=
URLSCAN_KEY=
URLHAUS_AUTH_KEY=

# Police console passcode
CONSOLE_PASSWORD=change-me

# Public base URL (set automatically on Render)
PUBLIC_BASE_URL=http://localhost:8000

# Web push keys (generate once and keep them stable)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Database (SQLite locally; on Render it is set from the PostgreSQL database)
DATABASE_URL=sqlite:///./trust_issues.db

# Small servers (1 CPU / 2 GB, e.g. Render Standard): fewer parallel sandbox scans and slower hunters
LOW_RESOURCE=false

# Optional
TELEGRAM_BOT_TOKEN=

# Sign-in codes are emailed over SMTP. With Gmail: turn on 2-Step Verification, create an
# App password at https://myaccount.google.com/apppasswords and put it here.
SMTP_USER=
SMTP_PASSWORD=
