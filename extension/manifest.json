{
  "manifest_version": 3,
  "name": "Trust Issues | أزمة ثقة",
  "short_name": "Trust Issues",
  "version": "1.0.0",
  "description": "Flags fake and scam links on Google Search, Google Maps and WhatsApp Web, and stops you before you open one.",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Trust Issues: check this page",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "*://www.google.com/*",
    "*://www.google.ae/*",
    "*://www.google.com.sa/*",
    "*://www.google.com.qa/*",
    "*://www.google.com.kw/*",
    "*://www.google.com.bh/*",
    "*://www.google.com.om/*",
    "*://www.google.com.eg/*",
    "*://www.google.jo/*",
    "*://www.google.co.uk/*",
    "*://www.google.co.in/*",
    "*://www.google.com.pk/*",
    "*://www.google.com.ph/*",
    "*://www.google.com.bd/*",
    "https://web.whatsapp.com/*",
    "http://localhost:8000/*",
    "https://*.up.railway.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.google.com/search*",
        "*://www.google.ae/search*",
        "*://www.google.com.sa/search*",
        "*://www.google.com.qa/search*",
        "*://www.google.com.kw/search*",
        "*://www.google.com.bh/search*",
        "*://www.google.com.om/search*",
        "*://www.google.com.eg/search*",
        "*://www.google.jo/search*",
        "*://www.google.co.uk/search*",
        "*://www.google.co.in/search*",
        "*://www.google.com.pk/search*",
        "*://www.google.com.ph/search*",
        "*://www.google.com.bd/search*"
      ],
      "js": [
        "content/core.js",
        "content/google-search.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.google.com/maps*",
        "*://www.google.ae/maps*",
        "*://www.google.com.sa/maps*",
        "*://www.google.com.qa/maps*",
        "*://www.google.com.kw/maps*",
        "*://www.google.com.bh/maps*",
        "*://www.google.com.om/maps*",
        "*://www.google.com.eg/maps*",
        "*://www.google.jo/maps*",
        "*://www.google.co.uk/maps*",
        "*://www.google.co.in/maps*",
        "*://www.google.com.pk/maps*",
        "*://www.google.com.ph/maps*",
        "*://www.google.com.bd/maps*"
      ],
      "js": [
        "content/core.js",
        "content/google-maps.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content/core.js",
        "content/whatsapp.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
